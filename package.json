{
  "name": "omnishell-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:share && tsc -b && vite build",
    "tauri": "tauri",
    "test": "playwright test",
    "build:share": "esbuild src/share-client.ts --bundle --format=iife --outfile=assets/share-client.js --legal-comments=inline",
    "format": "prettier --write src package.json vite.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
