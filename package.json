{
  "name": "omnishell-studio",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:share && tsc -b && vite build",
    "tauri": "tauri",
    "test": "playwright test",
    "build:share": "esbuild src/share-client.ts --bundle --format=iife --outfile=assets/share-client.js --legal-comments=inline",
    "format": "prettier --write src package.json vite.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:daemon": "node scripts/build-daemon.mjs",
    "annotate": "node scripts/annotate-source.mjs",
    "benchmark": "cargo run --release --features desktop --manifest-path src-tauri/Cargo.toml --example benchmark"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@noble/hashes": "^1.8.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xyflow/react": "^12.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
