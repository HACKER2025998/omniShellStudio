{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniShell Studio",
  "version": "1.0.0-rc.1",
  "identifier": "dev.xhackerip.omnishell",
  "build": {
    "beforeDevCommand": "npm run build:daemon -- --debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:daemon && npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "OmniShell Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 740
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg"
    ],
    "shortDescription": "Votre atelier système hors ligne",
    "externalBin": [
      "binaries/omnishell-daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
